{
  // backend / core と同じ ESM・strict 設定に揃える（ADR 0004）。
  // @azure/functions v4 は Node 18+ で ESM 起動に対応しているため、
  // CommonJS から nodenext へ移行して @parking/core を import できるようにする。
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "sourceMap": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src"]
}
