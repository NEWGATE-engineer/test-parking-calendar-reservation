{
  "name": "functions",
  "version": "1.0.0",
  "description": "駐車場予約システム 非同期・イベント処理（Azure Functions / TypeScript）",
  "type": "module",
  "main": "dist/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "test": "echo \"No tests yet...\""
  },
  "dependencies": {
    "@azure/functions": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "rimraf": "^5.0.0",
    "typescript": "^6.0.3"
  }
}
