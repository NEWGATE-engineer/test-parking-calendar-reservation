{
  // backend と同一の設定に揃える（ESM / nodenext / strict）。
  // core は他パッケージ（backend / functions）から import されるため、
  // declaration / declarationMap を出して型と go-to-definition を提供する。
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],

    // Interop（CJS パッケージ mssql を default import するため）
    "esModuleInterop": true,

    // Other Outputs（型公開のため必須）
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src"]
}
